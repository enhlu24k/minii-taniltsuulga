        card.addEventListener("mouseenter", () => sfx.hover());
        card.addEventListener("click", () => {
          sfx.click();
          selectedCategoryId = cat.id;
          renderCategories();
          updateStartUI();
        });
        categoryGrid.appendChild(card);
      });
    }

    function updateStartUI() {
      const cat = CATEGORIES[selectedCategoryId];
      startBtn.textContent = `${cat.icon} ${cat.short} — Эхлүүлэх ▶`;

      document.getElementById("savedTopRecord").textContent = getTopRecord();
      document.getElementById("savedTotalScore").textContent = savedStats.totalScore;
      document.getElementById("savedGames").textContent = savedStats.gamesPlayed;

      bestText.textContent = savedStats.highScores[selectedCategoryId] || 0;
      resetStatsBtn.style.display =
        savedStats.gamesPlayed > 0 || getTopRecord() > 0 ? "inline-block" : "none";
    }

    // --- Helpers ---
    function shuffle(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function switchScreen(target) {
      [startScreen, gameScreen, endScreen].forEach(s => s.classList.remove("active"));
      target.classList.add("active");
    }

    function updateHUD() {
      const catBest = savedStats.highScores[selectedCategoryId] || 0;
      scoreText.textContent = score;
      bestText.textContent = Math.max(catBest, score);
      streakText.textContent = streak;
      streakPill.classList.toggle("active", streak >= 2);

      const hearts = livesBox.querySelectorAll(".heart");
      hearts.forEach((h, idx) => {
        h.classList.toggle("lost", idx >= lives);
      });

      const progress = questions.length ? (currentIndex / questions.length) * 100 : 0;
      progressBar.style.width = `${progress}%`;
    }

    function startGame() {
      if (transitionTimer) clearTimeout(transitionTimer);
      sfx.click();

      const cat = CATEGORIES[selectedCategoryId];
      questions = shuffle(cat.questions).map(q => ({
        ...q,
        options: shuffle(q.options)
      }));

      currentIndex = 0;
      lives = MAX_LIVES;
      score = 0;
      streak = 0;
      bestStreak = 0;
      correctCount = 0;
      locked = false;

      activeCatPill.textContent = `${cat.icon} ${cat.name}`;
      updateHUD();
      switchScreen(gameScreen);
      renderQuestion();
    }

    function renderQuestion() {
      locked = false;
      feedbackBar.textContent = "";
      feedbackBar.className = "feedback-bar";

      const q = questions[currentIndex];
      questionMeta.textContent = `Асуулт ${currentIndex + 1} / ${questions.length}`;
      emojiDisplay.textContent = q.emoji;
      progressBar.style.width = `${(currentIndex / questions.length) * 100}%`;

      optionsGrid.innerHTML = "";
      q.options.forEach((opt, i) => {
        const btn = document.createElement("button");
        btn.className = "option-btn";
        btn.innerHTML = `<span class="option-key">${i + 1}</span><span>${opt}</span>`;
        btn.addEventListener("mouseenter", () => sfx.hover());
        btn.addEventListener("click", () => handleAnswer(opt, btn));
        optionsGrid.appendChild(btn);
      });
    }

    function handleAnswer(selected, btnEl) {
      if (locked) return;
      locked = true;

      const q = questions[currentIndex];
      const buttons = [...optionsGrid.querySelectorAll(".option-btn")];
      buttons.forEach(b => (b.disabled = true));

      if (selected === q.answer) {
        btnEl.classList.add("correct");
        streak++;
        if (streak > bestStreak) bestStreak = streak;
        correctCount++;

        const bonus = streak >= 2 ? (streak - 1) * 5 : 0;
        const gained = 10 + bonus;
        score += gained;

        feedbackBar.textContent = bonus > 0
          ? `✅ Зөв! +${gained} оноо (🔥 ${streak} дарааллаа)`
          : `✅ Зөв таалаа! +${gained} оноо`;
        feedbackBar.className = "feedback-bar good";
        sfx.correct();
      } else {
        btnEl.classList.add("wrong");
        buttons.forEach(b => {
          if (b.querySelector("span:last-child").textContent === q.answer) {
            b.classList.add("correct");
          }
        });

        lives--;
        streak = 0;
        feedbackBar.textContent = `❌ Буруу! Зөв хариу: ${q.answer}`;
        feedbackBar.className = "feedback-bar bad";

        appCard.classList.remove("shake");
        void appCard.offsetWidth;
        appCard.classList.add("shake");
        sfx.wrong();
      }

      updateHUD();

      transitionTimer = setTimeout(() => {
        if (lives <= 0) {
          endGame(false);
        } else if (currentIndex + 1 >= questions.length) {
          currentIndex++;
          updateHUD();
          endGame(true);
        } else {
          currentIndex++;
          renderQuestion();
        }
      }, 1150);
    }

    function endGame(won) {
      const cat = CATEGORIES[selectedCategoryId];
      const prevBest = savedStats.highScores[selectedCategoryId] || 0;
      const isNewRecord = score > 0 && score > prevBest;

      savedStats.gamesPlayed += 1;
      savedStats.totalScore += score;
      if (score > prevBest) {
        savedStats.highScores[selectedCategoryId] = score;
      }
      saveStats();
      renderCategories();
      updateStartUI();

      progressBar.style.width = won ? "100%" : progressBar.style.width;
      switchScreen(endScreen);

      newRecordBadge.classList.toggle("show", isNewRecord);
      finalScore.textContent = score;
      finalBest.textContent = savedStats.highScores[selectedCategoryId];
      finalCorrect.textContent = `${correctCount}/${questions.length}`;

      if (won) {
        endIcon.textContent = "🏆";
        endTitle.textContent = `${cat.short} — Та яллаа!`;
        endSubtitle.textContent = `Үлдсэн ${lives} амьтайгаар бүх ${questions.length} асуултыг давж гарлаа!`;
        sfx.win();
      } else {
        endIcon.textContent = isNewRecord ? "🥇" : "💔";
        endTitle.textContent = "Тоглоом дууслаа";
        endSubtitle.textContent = isNewRecord
          ? `3 амь дууссан ч ${cat.short} төрөлд шинэ рекорд тогтоолоо!`
          : "Таны 3 амь дууслаа. Дахиад оролдоод үзээрэй!";
        isNewRecord ? sfx.win() : sfx.gameOver();
      }
    }

    function goToHome() {
      if (transitionTimer) clearTimeout(transitionTimer);
      sfx.click();
      score = 0;
      streak = 0;
      lives = MAX_LIVES;
      progressBar.style.width = "0%";
      scoreText.textContent = "0";
      streakPill.classList.remove("active");
      livesBox.querySelectorAll(".heart").forEach(h => h.classList.remove("lost"));
      renderCategories();
      updateStartUI();
      switchScreen(startScreen);
    }

    // --- Event Listeners ---
    startBtn.addEventListener("click", startGame);
    document.getElementById("restartBtn").addEventListener("click", startGame);
    document.getElementById("backHomeBtn").addEventListener("click", goToHome);
    document.getElementById("quitToMenuBtn").addEventListener("click", goToHome);

    resetStatsBtn.addEventListener("click", () => {
      sfx.click();
      savedStats = defaultStats();
      saveStats();
      renderCategories();
      updateStartUI();
    });

    [
      startBtn,
      document.getElementById("restartBtn"),
      document.getElementById("backHomeBtn"),
      document.getElementById("quitToMenuBtn"),
      resetStatsBtn,
      soundToggle
    ].forEach(el => {
      el.addEventListener("mouseenter", () => sfx.hover());
    });

    soundToggle.addEventListener("click", () => {
      sfx.init();
      sfx.muted = !sfx.muted;
      soundToggle.textContent = sfx.muted ? "🔇" : "🔊";
      if (!sfx.muted) sfx.click();
    });

    document.addEventListener("keydown", (e) => {
      if (!gameScreen.classList.contains("active") || locked) return;
      const idx = ["1", "2", "3", "4"].indexOf(e.key);
      if (idx !== -1) {
        const btns = optionsGrid.querySelectorAll(".option-btn");
        if (btns[idx]) btns[idx].click();
      }
    });

    // Init
    renderCategories();
    updateStartUI();
  </script>
</body>
</html>
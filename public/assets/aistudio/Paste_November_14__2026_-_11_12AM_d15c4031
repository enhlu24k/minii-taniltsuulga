<!DOCTYPE html>
<html lang="mn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>🏆 Sports Emoji Guesser — 4 Ангилалтай</title>
  <style>
    :root {
      --bg-dark: #060919;
      --bg-card: rgba(13, 19, 43, 0.88);
      --border-glass: rgba(56, 189, 248, 0.25);
      --accent: #3b82f6;
      --accent-glow: #38bdf8;
      --accent-violet: #8b5cf6;
      --gold: #fbbf24;
      --danger: #ef4444;
      --success: #10b981;
      --success-glow: #34d399;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at 18% 18%, rgba(56, 189, 248, 0.20), transparent 45%),
        radial-gradient(circle at 82% 82%, rgba(139, 92, 246, 0.22), transparent 45%),
        repeating-linear-gradient(
          90deg,
          rgba(255, 255, 255, 0.015) 0px,
          rgba(255, 255, 255, 0.015) 60px,
          transparent 60px,
          transparent 120px
        ),
        var(--bg-dark);
      color: var(--text-main);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      overflow-x: hidden;
    }

    .app-container {
      width: 100%;
      max-width: 660px;
      background: var(--bg-card);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border-glass);
      border-radius: 26px;
      padding: 28px;
      box-shadow:
        0 25px 65px rgba(0, 0, 0, 0.72),
        0 0 40px rgba(59, 130, 246, 0.12),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
      position: relative;
      overflow: hidden;
    }

    .app-container::before {
      content: "";
      position: absolute;
      top: 0;
      left: 15%;
      right: 15%;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--accent-glow), var(--accent-violet), transparent);
      border-radius: 99px;
    }

    /* Header HUD */
    .hud {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }

    .hud-group {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .pill {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 7px 13px;
      border-radius: 999px;
      font-size: 0.88rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .pill.score {
      color: var(--gold);
      border-color: rgba(251, 191, 36, 0.32);
      background: rgba(251, 191, 36, 0.08);
    }

    .pill.best {
      color: var(--accent-glow);
      border-color: rgba(56, 189, 248, 0.32);
      background: rgba(56, 189, 248, 0.08);
    }

    .pill.streak {
      color: #fb923c;
      border-color: rgba(251, 146, 60, 0.35);
      background: rgba(251, 146, 60, 0.1);
      display: none;
    }

    .pill.streak.active {
      display: inline-flex;
      animation: popIn 0.3s ease;
    }

    /* Lives / Hearts */
    .lives {
      display: flex;
      align-items: center;
      gap: 5px;
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.28);
      padding: 6px 12px;
      border-radius: 999px;
    }

    .heart {
      font-size: 1.15rem;
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.35s ease, filter 0.35s ease;
      display: inline-block;
    }

    .heart.lost {
      opacity: 0.22;
      filter: grayscale(1);
      transform: scale(0.75) rotate(-15deg);
    }

    /* Sound Toggle Button */
    .icon-btn {
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.14);
      color: var(--text-main);
      width: 40px;
      height: 40px;
      border-radius: 50%;
      cursor: pointer;
      display: grid;
      place-items: center;
      font-size: 1.1rem;
      transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .icon-btn:hover {
      background: rgba(56, 189, 248, 0.2);
      border-color: var(--accent-glow);
      transform: translateY(-2px) scale(1.08);
      box-shadow: 0 6px 18px rgba(56, 189, 248, 0.35);
    }

    /* Progress Bar */
    .progress-wrap {
      width: 100%;
      height: 8px;
      background: rgba(255, 255, 255, 0.07);
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 22px;
    }

    .progress-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--accent), var(--accent-glow), var(--accent-violet));
      border-radius: 999px;
      transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 0 14px rgba(56, 189, 248, 0.65);
    }

    /* Screens */
    .screen {
      display: none;
      animation: fadeSlideUp 0.38s ease forwards;
    }

    .screen.active {
      display: block;
    }

    /* Start Screen */
    .hero {
      text-align: center;
    }

    .hero-badge {
      display: inline-block;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(56, 189, 248, 0.14);
      border: 1px solid rgba(56, 189, 248, 0.38);
      color: var(--accent-glow);
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.6px;
      margin-bottom: 10px;
    }

    .hero h1 {
      font-size: 2rem;
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 8px;
      background: linear-gradient(135deg, #ffffff 25%, #38bdf8 70%, #a78bfa 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      color: var(--text-muted);
      font-size: 0.94rem;
      margin-bottom: 18px;
    }

    /* Saved Stats Banner */
    .saved-banner {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 18px;
    }

    .saved-item {
      background: rgba(59, 130, 246, 0.08);
      border: 1px solid rgba(56, 189, 248, 0.22);
      border-radius: 14px;
      padding: 10px 8px;
      transition: transform 0.22s ease, border-color 0.22s ease;
    }

    .saved-item:hover {
      transform: translateY(-2px);
      border-color: var(--accent-glow);
    }

    .saved-item .val {
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--accent-glow);
    }

    .saved-item .lbl {
      font-size: 0.74rem;
      color: var(--text-muted);
      margin-top: 2px;
    }

    /* Category Selector Grid */
    .cat-title {
      text-align: left;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--accent-glow);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 10px;
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 18px;
    }

    .cat-card {
      background: rgba(255, 255, 255, 0.045);
      border: 1.5px solid rgba(255, 255, 255, 0.12);
      border-radius: 18px;
      padding: 15px 14px;
      cursor: pointer;
      text-align: left;
      color: var(--text-main);
      display: flex;
      align-items: center;
      gap: 12px;
      position: relative;
      overflow: hidden;
      transition:
        transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
        border-color 0.22s ease,
        background 0.22s ease,
        box-shadow 0.22s ease;
    }

    .cat-card:hover {
      transform: translateY(-4px) scale(1.02);
      border-color: rgba(56, 189, 248, 0.65);
      background: rgba(59, 130, 246, 0.14);
      box-shadow: 0 12px 26px rgba(56, 189, 248, 0.22);
    }

    .cat-card.selected {
      border-color: var(--accent-glow);
      background: linear-gradient(135deg, rgba(37, 99, 235, 0.25), rgba(139, 92, 246, 0.22));
      box-shadow: 0 0 24px rgba(56, 189, 248, 0.35);
    }

    .cat-card.selected::after {
      content: "✓";
      position: absolute;
      top: 10px;
      right: 12px;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--accent-glow);
      color: #061224;
      font-size: 0.78rem;
      font-weight: 900;
      display: grid;
      place-items: center;
    }

    .cat-icon {
      font-size: 2rem;
      width: 46px;
      height: 46px;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.06);
      display: grid;
      place-items: center;
      flex-shrink: 0;
      transition: transform 0.25s ease;
    }

    .cat-card:hover .cat-icon {
      transform: scale(1.1) rotate(-6deg);
    }

    .cat-info h4 {
      font-size: 0.98rem;
      font-weight: 700;
      margin-bottom: 3px;
    }

    .cat-meta {
      font-size: 0.76rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .cat-best {
      color: var(--gold);
      font-weight: 700;
    }

    .rules-box {
      background: rgba(4, 8, 24, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 16px;
      padding: 13px 16px;
      text-align: left;
      margin-bottom: 18px;
      font-size: 0.88rem;
      color: #cbd5e1;
      display: flex;
      flex-wrap: wrap;
      gap: 10px 18px;
      justify-content: center;
    }

    .rules-box span strong {
      color: var(--text-main);
    }

    /* Primary Button */
    .btn-primary {
      width: 100%;
      padding: 16px 24px;
      border: none;
      border-radius: 16px;
      background: linear-gradient(135deg, #2563eb, #4f46e5, #0891b2);
      color: #fff;
      font-size: 1.08rem;
      font-weight: 700;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s ease;
      box-shadow: 0 10px 26px rgba(37, 99, 235, 0.42);
    }

    .btn-primary::after {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 60%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
      transform: skewX(-20deg);
      transition: left 0.55s ease;
    }

    .btn-primary:hover {
      transform: translateY(-3px) scale(1.015);
      box-shadow: 0 16px 36px rgba(56, 189, 248, 0.5);
    }

    .btn-primary:hover::after {
      left: 140%;
    }

    .btn-primary:active {
      transform: translateY(0) scale(0.99);
    }

    .btn-row {
      display: flex;
      gap: 10px;
      justify-content: center;
      margin-top: 12px;
      flex-wrap: wrap;
    }

    .btn-ghost {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.14);
      color: var(--text-muted);
      padding: 9px 16px;
      border-radius: 12px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.22s ease;
    }

    .btn-ghost:hover {
      color: var(--text-main);
      border-color: var(--accent-glow);
      background: rgba(56, 189, 248, 0.1);
      transform: translateY(-1px);
    }

    .btn-ghost.danger:hover {
      color: #f87171;
      border-color: rgba(248, 113, 113, 0.45);
      background: rgba(239, 68, 68, 0.08);
    }

    /* Game Screen */
    .question-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
      gap: 10px;
    }

    .cat-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      border-radius: 999px;
      background: rgba(139, 92, 246, 0.18);
      border: 1px solid rgba(167, 139, 250, 0.35);
      color: #ddd6fe;
      font-size: 0.82rem;
      font-weight: 700;
    }

    .question-meta {
      color: var(--text-muted);
      font-size: 0.9rem;
      font-weight: 600;
    }

    .emoji-stage {
      background:
        radial-gradient(circle at center, rgba(59, 130, 246, 0.18), rgba(6, 10, 28, 0.55));
      border: 1px solid rgba(56, 189, 248, 0.25);
      border-radius: 22px;
      padding: 36px 20px;
      text-align: center;
      margin-bottom: 22px;
      position: relative;
      transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .emoji-stage:hover {
      transform: scale(1.015);
      border-color: rgba(56, 189, 248, 0.55);
      box-shadow: 0 12px 32px rgba(56, 189, 248, 0.18);
    }

    .emoji-display {
      font-size: clamp(3rem, 9vw, 4.3rem);
      letter-spacing: 10px;
      display: inline-block;
      filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.55));
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      user-select: none;
    }

    .emoji-stage:hover .emoji-display {
      transform: scale(1.08) translateY(-3px);
    }

    /* Options Grid */
    .options-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    @media (max-width: 520px) {
      .options-grid, .category-grid {
        grid-template-columns: 1fr;
      }
      .app-container {
        padding: 20px;
      }
    }

    .option-btn {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: var(--text-main);
      padding: 16px 18px;
      border-radius: 16px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 12px;
      text-align: left;
      position: relative;
      overflow: hidden;
      transition:
        transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
        background 0.22s ease,
        border-color 0.22s ease,
        box-shadow 0.22s ease;
    }

    .option-key {
      width: 28px;
      height: 28px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.14);
      display: grid;
      place-items: center;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-muted);
      flex-shrink: 0;
      transition: all 0.22s ease;
    }

    .option-btn:not(:disabled):hover {
      transform: translateY(-4px) scale(1.02);
      background: rgba(59, 130, 246, 0.18);
      border-color: var(--accent-glow);
      box-shadow: 0 10px 24px rgba(56, 189, 248, 0.26);
    }

    .option-btn:not(:disabled):hover .option-key {
      background: var(--accent-glow);
      color: #082f49;
      border-color: var(--accent-glow);
      transform: scale(1.1);
    }

    .option-btn:disabled {
      cursor: default;
    }

    .option-btn.correct {
      background: rgba(16, 185, 129, 0.28);
      border-color: var(--success-glow);
      box-shadow: 0 0 24px rgba(16, 185, 129, 0.45);
      transform: scale(1.02);
    }

    .option-btn.correct .option-key {
      background: var(--success-glow);
      color: #022c22;
    }

    .option-btn.wrong {
      background: rgba(239, 68, 68, 0.25);
      border-color: #f87171;
      box-shadow: 0 0 22px rgba(239, 68, 68, 0.35);
    }

    .option-btn.wrong .option-key {
      background: #ef4444;
      color: #fff;
    }

    .feedback-bar {
      min-height: 28px;
      margin-top: 16px;
      text-align: center;
      font-weight: 700;
      font-size: 0.96rem;
      letter-spacing: 0.3px;
    }

    .feedback-bar.good {
      color: var(--success-glow);
    }

    .feedback-bar.bad {
      color: #f87171;
    }

    /* End Screen */
    .end-card {
      text-align: center;
      padding: 8px 0;
    }

    .end-icon {
      font-size: 4.2rem;
      margin-bottom: 10px;
      display: inline-block;
      animation: bounceIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .new-record-badge {
      display: none;
      margin: 0 auto 12px;
      padding: 6px 16px;
      border-radius: 999px;
      background: linear-gradient(90deg, rgba(251, 191, 36, 0.22), rgba(245, 158, 11, 0.25));
      border: 1px solid rgba(251, 191, 36, 0.6);
      color: var(--gold);
      font-size: 0.88rem;
      font-weight: 800;
      letter-spacing: 0.6px;
      width: fit-content;
      animation: popIn 0.4s ease;
    }

    .new-record-badge.show {
      display: inline-block;
    }

    .end-card h2 {
      font-size: 1.9rem;
      font-weight: 800;
      margin-bottom: 8px;
    }

    .end-card p {
      color: var(--text-muted);
      margin-bottom: 22px;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 24px;
    }

    .stat-box {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      padding: 14px 10px;
      transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .stat-box:hover {
      transform: translateY(-3px);
      border-color: var(--accent-glow);
    }

    .stat-val {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--accent-glow);
    }

    .stat-label {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-top: 4px;
    }

    /* Animations */
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20% { transform: translateX(-8px); }
      40% { transform: translateX(8px); }
      60% { transform: translateX(-6px); }
      80% { transform: translateX(6px); }
    }

    .shake {
      animation: shake 0.42s ease;
    }

    @keyframes fadeSlideUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes popIn {
      from { transform: scale(0.7); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    @keyframes bounceIn {
      0% { transform: scale(0.3); opacity: 0; }
      70% { transform: scale(1.15); opacity: 1; }
      100% { transform: scale(1); }
    }
  </style>
</head>
<body>

  <main class="app-container" id="appCard">
    <!-- Top HUD -->
    <header class="hud">
      <div class="hud-group">
        <div class="pill score" title="Одоогийн оноо">🏆 <span id="scoreText">0</span></div>
        <div class="pill best" title="Тухайн төрлийн дээд оноо">👑 <span id="bestText">0</span></div>
        <div class="pill streak" id="streakPill">🔥 <span id="streakText">0</span></div>
      </div>

      <div class="hud-group">
        <div class="lives" id="livesBox" title="Үлдсэн амь">
          <span class="heart">❤️</span>
          <span class="heart">❤️</span>
          <span class="heart">❤️</span>
        </div>
        <button class="icon-btn" id="soundToggle" title="Дуу хаах/нээх" aria-label="Дуу удирдах">🔊</button>
      </div>
    </header>

    <div class="progress-wrap">
      <div class="progress-bar" id="progressBar"></div>
    </div>

    <!-- Start Screen -->
    <section class="screen active" id="startScreen">
      <div class="hero">
        <div class="hero-badge">🏆 SPORTS EMOJI QUIZ</div>
        <h1>Тамирчин Таах Тоглоом</h1>
        <p>Эможи сэжүүрээр дуртай спортынхоо шилдэг оддыг таагаарай!</p>

        <div class="saved-banner">
          <div class="saved-item">
            <div class="val" id="savedTopRecord">0</div>
            <div class="lbl">👑 Нийт рекорд</div>
          </div>
          <div class="saved-item">
            <div class="val" id="savedTotalScore">0</div>
            <div class="lbl">📊 Нийт оноо</div>
          </div>
          <div class="saved-item">
            <div class="val" id="savedGames">0</div>
            <div class="lbl">🎮 Тоглосон</div>
          </div>
        </div>

        <div class="cat-title">📌 Төрөл сонгох:</div>
        <div class="category-grid" id="categoryGrid"></div>

        <div class="rules-box">
          <span>❤️ <strong>3 амьтай</strong></span>
          <span>🔥 <strong>Streak</strong> нэмэлт оноо</span>
          <span>⌨️ <strong>1–4</strong> товч</span>
          <span>💾 Оноо <strong>хадгалагдана</strong></span>
        </div>

        <button class="btn-primary" id="startBtn">⚽ Хөлбөмбөг — Эхлүүлэх ▶</button>
        <div class="btn-row">
          <button class="btn-ghost danger" id="resetStatsBtn">🗑️ Хадгалсан оноо цэвэрлэх</button>
        </div>
      </div>
    </section>

    <!-- Game Screen -->
    <section class="screen" id="gameScreen">
      <div class="question-header">
        <span class="cat-pill" id="activeCatPill">⚽ Хөлбөмбөгчид</span>
